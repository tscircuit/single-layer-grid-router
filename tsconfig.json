{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "lib/*": ["./lib/*"],
      "tests/*": ["./tests/*"]
    },
    "types": ["bun"]
  },
  "include": ["lib", "tests", "pages", "*.tsx", "vite.config.ts"]
}
